@node Main "XGWorks Lite"

                         @{b}XGWorks Lite@{ub}
            MIDI / XG song player for AmigaOS 3.x (68020+)

   @{" Introduction          " link Intro}
   @{" Starting              " link Start}
   @{" The main window       " link Main_Window}
   @{" The mixer             " link Mixer}
   @{" Effects               " link Effects}
   @{" Lyrics and chords     " link Lyrics}
   @{" XGworks songs (.XWS)  " link XWS}
